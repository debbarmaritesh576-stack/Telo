<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.telo.app.ui.SplashActivity"
        android:label="Splash">
        <action
            android:id="@+id/action_splash_to_unlock"
            app:destination="@id/unlockFragment" />
        <action
            android:id="@+id/action_splash_to_intro"
            app:destination="@id/introFragment" />
    </fragment>

    <fragment
        android:id="@+id/introFragment"
        android:name="com.telo.app.ui.IntroActivity"
        android:label="Intro">
        <action
            android:id="@+id/action_intro_to_unlock"
            app:destination="@id/unlockFragment" />
    </fragment>

    <fragment
        android:id="@+id/unlockFragment"
        android:name="com.telo.app.ui.UnlockActivity"
        android:label="Unlock">
        <action
            android:id="@+id/action_unlock_to_home"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.telo.app.ui.HomeActivity"
        android:label="Home">
        <action
            android:id="@+id/action_home_to_edit_otp"
            app:destination="@id/editOTPFragment" />
        <action
            android:id="@+id/action_home_to_edit_password"
            app:destination="@id/editPasswordFragment" />
        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/editOTPFragment"
        android:name="com.telo.app.ui.EditOTPActivity"
        android:label="Edit 2FA">
        <argument
            android:name="entry_id"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/editPasswordFragment"
        android:name="com.telo.app.ui.EditPasswordActivity"
        android:label="Edit Password">
        <argument
            android:name="entry_id"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.telo.app.ui.SettingsActivity"
        android:label="Settings" />

</navigation>