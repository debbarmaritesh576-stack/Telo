<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/tv_pin_display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="○  ○  ○  ○"
        android:textSize="32sp"
        android:letterSpacing="0.3"
        android:layout_marginBottom="32dp" />

    <!-- Row 1: 1 2 3 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button android:id="@+id/btn_pin_1" style="@style/PinButton" android:text="1" />
        <Button android:id="@+id/btn_pin_2" style="@style/PinButton" android:text="2" android:layout_marginHorizontal="12dp" />
        <Button android:id="@+id/btn_pin_3" style="@style/PinButton" android:text="3" />

    </LinearLayout>

    <!-- Row 2: 4 5 6 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button android:id="@+id/btn_pin_4" style="@style/PinButton" android:text="4" />
        <Button android:id="@+id/btn_pin_5" style="@style/PinButton" android:text="5" android:layout_marginHorizontal="12dp" />
        <Button android:id="@+id/btn_pin_6" style="@style/PinButton" android:text="6" />

    </LinearLayout>

    <!-- Row 3: 7 8 9 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button android:id="@+id/btn_pin_7" style="@style/PinButton" android:text="7" />
        <Button android:id="@+id/btn_pin_8" style="@style/PinButton" android:text="8" android:layout_marginHorizontal="12dp" />
        <Button android:id="@+id/btn_pin_9" style="@style/PinButton" android:text="9" />

    </LinearLayout>

    <!-- Row 4: del 0 ok -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btn_pin_delete" style="@style/PinButton" android:text="⌫" />
        <Button android:id="@+id/btn_pin_0" style="@style/PinButton" android:text="0" android:layout_marginHorizontal="12dp" />
        <Space android:layout_width="64dp" android:layout_height="64dp" />

    </LinearLayout>

</LinearLayout>